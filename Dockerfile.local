FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY scripts ./scripts
COPY tsconfig.json ./
RUN node scripts/build-local.mjs --outdir /app/dist-local

FROM node:24-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist-local ./dist-local
# Keep source and ingestion CLI paths available to the isolated host job runner.
COPY --from=build /app/src ./src
COPY --from=build /app/scripts ./scripts
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD ["node", "--input-type=module", "-e", "fetch('http://127.0.0.1:8787/health',{headers:{host:'127.0.0.1:8787'}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "--max-old-space-size=256", "dist-local/server.mjs"]
